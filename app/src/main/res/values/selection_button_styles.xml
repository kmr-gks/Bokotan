<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Bokotan.SelectionButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/selection_button_background</item>
        <item name="android:textColor">@color/selection_button_text</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Bokotan.SelectionButton.Secondary" parent="Widget.Bokotan.SelectionButton">
        <item name="backgroundTint">@color/selection_button_secondary_background</item>
        <item name="android:textColor">@color/selection_button_secondary_text</item>
        <item name="strokeColor">@color/selection_button_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
    </style>
</resources>
