<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools">

	<data>

	</data>

	<androidx.constraintlayout.widget.ConstraintLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@color/background">

		<TextView
			android:id="@+id/textViewMonme"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent" />

		<TextView
			android:id="@+id/textViewDebug"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="#00FF0A"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/textViewMonme" />

		<TextView
			android:id="@+id/textViewMaruBatsu"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="96sp"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintTop_toBottomOf="@+id/buttonEndQuiz" />

		<TextView
			android:id="@+id/textViewEditorial"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="18sp"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@+id/textViewDebug" />

		<TextView
			android:id="@+id/textViewNo"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			app:layout_constraintBottom_toTopOf="@+id/textViewMondai"
			app:layout_constraintStart_toStartOf="parent" />

		<TextView
			android:id="@+id/textViewMondai"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:contentDescription="@string/choice"
			android:textSize="40sp"
			app:layout_constraintBottom_toTopOf="@+id/buttonSelect1"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent" />

		<Button
			android:id="@+id/buttonHint"
			android:visibility="gone"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/hint"
			android:textColor="@color/buttontext"
			app:layout_constraintBottom_toTopOf="@+id/buttonSelect1"
			app:layout_constraintEnd_toEndOf="parent" />

		<Button
			android:id="@+id/buttonSelect1"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:autoSizeTextType="uniform"
			android:contentDescription="@string/choice"
			android:lines="1"
			android:textAlignment="center"
			android:textColor="@color/buttontext"
			app:layout_constraintBottom_toTopOf="@+id/buttonSelect2"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent" />

		<Button
			android:id="@+id/buttonSelect2"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:autoSizeTextType="uniform"
			android:contentDescription="@string/choice"
			android:lines="1"
			android:textAlignment="center"
			android:textColor="@color/buttontext"
			app:layout_constraintBottom_toTopOf="@+id/buttonSelect3"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent" />

		<Button
			android:id="@+id/buttonSelect3"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:autoSizeTextType="uniform"
			android:contentDescription="@string/choice"
			android:lines="1"
			android:textAlignment="center"
			android:textColor="@color/buttontext"
			app:layout_constraintBottom_toTopOf="@+id/buttonSelect4"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent" />

		<Button
			android:id="@+id/buttonSelect4"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:autoSizeTextType="uniform"
			android:contentDescription="@string/choice"
			android:lines="1"
			android:textAlignment="center"
			android:textColor="@color/buttontext"
			app:layout_constraintBottom_toTopOf="@+id/buttonIdontKnow"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent" />

		<Button
			android:id="@+id/buttonIdontKnow"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/idonknow"
			android:textColor="@color/buttontext"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/buttonEndQuiz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/end_quiz"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/quizContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:constraint_referenced_ids="textViewMonme,textViewDebug,textViewMaruBatsu,textViewEditorial,textViewNo,textViewMondai,buttonSelect1,buttonSelect2,buttonSelect3,buttonSelect4,buttonIdontKnow,buttonEndQuiz" />

        <ScrollView
            android:id="@+id/quizStartPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:background="@color/background"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quiz_title"
                    android:textColor="@color/textcolor"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:gravity="center" />
                <TextView
                    android:id="@+id/quizStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/quiz_not_started"
                    android:textColor="@color/textcolor"
                    android:textSize="18sp"
                    android:accessibilityLiveRegion="polite" />
                <Button
                    android:id="@+id/buttonStartSampleQuiz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/start_sample_quiz" />
                <Button
                    android:id="@+id/buttonChooseQuizRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_study_range" />
            </LinearLayout>
        </ScrollView>

	</androidx.constraintlayout.widget.ConstraintLayout>
</layout>